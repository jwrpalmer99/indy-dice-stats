<section class="ids-reset">
  <header class="ids-reset__header">
    <h2>{{localize "IDS.Reset.Title"}}</h2>
    <p>{{localize "IDS.Reset.Description"}}</p>
  </header>

  <div class="ids-reset__body">
    <label class="ids-control">
      <span>{{localize "IDS.Common.Player"}}</span>
      <select data-reset="user">
        <option value="all">{{localize "IDS.Common.AllPlayers"}}</option>
        {{#each users}}
          <option value="{{id}}">{{name}}</option>
        {{/each}}
      </select>
    </label>

    <div class="ids-reset__actions">
      <button type="button" class="ids-button ids-button--danger" data-action="reset-selected">
        {{localize "IDS.Reset.Button"}}
      </button>
    </div>
  </div>
</section>
