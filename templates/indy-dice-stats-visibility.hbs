<section class="ids-reset ids-visibility">
  <header class="ids-reset__header">
    <h2>{{localize "IDS.Visibility.Title"}}</h2>
    <p>{{localize "IDS.Visibility.Description"}}</p>
  </header>

  <div class="ids-reset__body">
    <fieldset class="ids-visibility__players" data-visibility="users">
      <legend>{{localize "IDS.Visibility.HiddenPlayers"}}</legend>
      {{#each users}}
        <label>
          <input type="checkbox" value="{{id}}" {{#if hidden}}checked{{/if}}>
          <span>{{name}}</span>
        </label>
      {{/each}}
    </fieldset>
    <p class="ids-reset__note">{{localize "IDS.Visibility.ReshowHint"}}</p>

    <div class="ids-reset__actions">
      <button type="button" class="ids-button" data-action="save-visibility">
        {{localize "IDS.Common.Save"}}
      </button>
    </div>
  </div>
</section>
