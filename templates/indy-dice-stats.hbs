<section class="ids-root">
  <header class="ids-header">
    <div class="ids-title" data-live-roll>
      <div class="ids-title__default" data-live-roll-default>
        <p class="ids-eyebrow">{{localize "IDS.App.Name"}}</p>
        <h1>{{localize "IDS.App.LuckLedger"}}</h1>
        <p class="ids-subtitle">{{localize "IDS.App.Subtitle"}}</p>
      </div>
      <div class="ids-title__live" data-live-roll-live hidden>
        <p class="ids-eyebrow">{{localize "IDS.Latest.Title"}} <span class="ids-live-roll-privacy" data-live-roll-privacy></span></p>
        <h1 class="ids-roll-user" data-live-roll-user>{{localize "IDS.Latest.Awaiting"}}</h1>
        <p class="ids-roll-actor" data-live-roll-actor hidden></p>
        <p class="ids-subtitle ids-roll-details" data-live-roll-details>{{localize "IDS.Latest.Listening"}}</p>
      </div>
    </div>
    <div class="ids-controls">
      <label class="ids-control">
        <span title="{{localize "IDS.Controls.PlayerHint"}}">{{localize "IDS.Common.Player"}}</span>
        <select data-filter="user">
          <option value="all" {{#if (eq defaultUserId "all")}}selected{{/if}}>{{localize "IDS.Common.AllPlayers"}}</option>
          {{#each users}}
            <option value="{{id}}" {{#if (eq ../defaultUserId id)}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </select>
      </label>
      <label class="ids-control ids-control--compare">
        <span title="{{localize "IDS.Controls.CompareHint"}}">{{localize "IDS.Controls.ComparePlayers"}}</span>
        <select data-filter="compare" multiple>
          <option value="">{{localize "IDS.Common.None"}}</option>
          {{#each users}}
            <option value="{{id}}">{{name}}</option>
          {{/each}}
        </select>
      </label>
      <label class="ids-control">
        <span title="{{localize "IDS.Controls.ActionHint"}}">{{localize "IDS.Common.Action"}}</span>
        <select data-filter="action">
          <option value="all" {{#if (eq defaultAction "all")}}selected{{/if}}>{{localize "IDS.Common.AllActions"}}</option>
          {{#each actionOptions}}
            <option value="{{key}}">{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="ids-control">
        <span title="{{localize "IDS.Controls.DetailHint"}}">{{localize "IDS.Controls.SaveCheck"}}</span>
        <select data-filter="detail">
          <option value="all">{{localize "IDS.Common.All"}}</option>
        </select>
      </label>
      <label class="ids-control ids-control--die">
        <span title="{{localize "IDS.Controls.DieHint"}}">{{localize "IDS.Common.Die"}}</span>
        <select data-filter="die">
          {{#each diceOptions}}
            <option value="{{this}}" {{#if (eq ../defaultDie this)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
      </label>
      <label class="ids-control">
        <span title="{{localize "IDS.Controls.SessionHint"}}">{{localize "IDS.Common.Session"}}</span>
        <select data-filter="session">
          <option value="all">{{localize "IDS.Common.AllTime"}}</option>
          <option value="today">{{localize "IDS.Common.Today"}}</option>
        </select>
      </label>
    </div>
  </header>

  <section class="ids-summary">
    <div class="ids-card ids-card--stat">
      <p class="ids-stat-label">{{localize "IDS.Summary.TotalDice"}}</p>
      <p class="ids-stat-value" data-stat="total-dice">0</p>
      <p class="ids-stat-foot">{{localize "IDS.Summary.TotalDiceHint"}}</p>
    </div>
    <div class="ids-card ids-card--stat">
      <p class="ids-stat-label" data-stat-label="filtered-dice">{{localize "IDS.Summary.FilteredDice"}}</p>
      <p class="ids-stat-value" data-stat="filtered-dice">0</p>
      <p class="ids-stat-foot">{{localize "IDS.Summary.FilteredDiceHint"}}</p>
    </div>
    <div class="ids-card ids-card--stat">
      <p class="ids-stat-label">{{localize "IDS.Summary.Average"}}</p>
      <p class="ids-stat-value" data-stat="die-average">-</p>
      <p class="ids-stat-foot">{{localize "IDS.Summary.AverageHint"}}</p>
    </div>
    <div class="ids-card ids-card--stat">
      <p class="ids-stat-label" data-stat-label="top-action">{{localize "IDS.Summary.TopAction"}}</p>
      <p class="ids-stat-value" data-stat="top-action">-</p>
      <p class="ids-stat-foot">{{localize "IDS.Summary.TopActionHint"}}</p>
    </div>
  </section>

  <section class="ids-charts">
    <div class="ids-card ids-chart-card">
      <div class="ids-chart-header">
        <p class="ids-chart-title" data-chart-title="distribution">{{localize "IDS.Charts.Distribution"}}</p>
        <div class="ids-chart-controls">
          <label class="ids-toggle" data-toggle="normalize" title="{{localize "IDS.Charts.NormalizeHint"}}">
            <input class="ids-toggle__input" type="checkbox" data-filter="normalize" />
            <span class="ids-toggle__track">
              <span class="ids-toggle__thumb"></span>
            </span>
            <span class="ids-toggle__label">{{localize "IDS.Charts.Normalize"}}</span>
          </label>
          <label class="ids-toggle is-hidden" data-toggle="candles" title="{{localize "IDS.Charts.CandlesHint"}}">
            <input class="ids-toggle__input" type="checkbox" data-filter="candles" />
            <span class="ids-toggle__track">
              <span class="ids-toggle__thumb"></span>
            </span>
            <span class="ids-toggle__label">{{localize "IDS.Charts.Candles"}}</span>
          </label>
          <label class="ids-toggle is-hidden" data-toggle="streaks" title="{{localize "IDS.Charts.StreakHint"}}">
            <input class="ids-toggle__input" type="checkbox" data-filter="streakType" />
            <span class="ids-toggle__track">
              <span class="ids-toggle__thumb"></span>
            </span>
            <span class="ids-toggle__label">{{localize "IDS.Charts.MaxStreak"}}</span>
          </label>
        </div>
      </div>
      <canvas data-chart="distribution" aria-label="{{localize "IDS.Charts.DistributionAria"}}"></canvas>
      <div class="ids-heatmap" data-chart="streaks" hidden></div>
    </div>
    <div class="ids-card ids-chart-card">
      <canvas data-chart="breakdown" aria-label="{{localize "IDS.Charts.BreakdownAria"}}"></canvas>
    </div>
  </section>

  <section class="ids-table">
    <div class="ids-card">
      <div class="ids-card-header">
        <h2>{{localize "IDS.Table.DieSummary"}}</h2>
        <p>{{localize "IDS.Table.DieSummaryHint"}}</p>
      </div>
      <div class="ids-table-wrap">
        <table>
          <thead>
            <tr>
              <th>{{localize "IDS.Common.Die"}}</th>
              <th>{{localize "IDS.Common.Count"}}</th>
              <th>{{localize "IDS.Common.Average"}}</th>
              <th>{{localize "IDS.Common.Min"}}</th>
              <th>{{localize "IDS.Common.Max"}}</th>
              <th>{{localize "IDS.Table.MinStreak"}}</th>
              <th>{{localize "IDS.Table.MaxStreak"}}</th>
            </tr>
          </thead>
          <tbody data-table="die-summary">
            <tr>
              <td colspan="7">{{localize "IDS.Table.NoRolls"}}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="ids-compare" data-compare hidden>
    <div class="ids-card">
      <div class="ids-card-header">
        <h2>{{localize "IDS.Table.PlayerComparison"}}</h2>
        <p>{{localize "IDS.Table.PlayerComparisonHint"}}</p>
      </div>
      <div class="ids-table-wrap">
        <table>
          <thead>
            <tr>
              <th>{{localize "IDS.Common.Player"}}</th>
              <th>{{localize "IDS.Table.TotalRolls"}}</th>
              <th>{{localize "IDS.Summary.TotalDice"}}</th>
              <th>{{localize "IDS.Summary.Average"}}</th>
            </tr>
          </thead>
          <tbody data-table="compare-summary">
            <tr>
              <td colspan="4">{{localize "IDS.Table.SelectPlayers"}}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</section>
