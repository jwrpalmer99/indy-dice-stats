<section class="ids-monitor-root">
  <div class="ids-title" data-live-roll>
    <div class="ids-title__default" data-live-roll-default>
      <p class="ids-eyebrow">{{localize "IDS.App.Name"}}</p>
      <h1>{{localize "IDS.App.LuckLedger"}}</h1>
      <p class="ids-subtitle">{{localize "IDS.App.Subtitle"}}<br><br>{{localize "IDS.App.MonitorHint"}}</p>
    </div>
    <div class="ids-title__live" data-live-roll-live hidden>
      <p class="ids-eyebrow">{{localize "IDS.Latest.Title"}} <span class="ids-live-roll-privacy" data-live-roll-privacy></span></p>
      <h1 class="ids-roll-user" data-live-roll-user>{{localize "IDS.Latest.Awaiting"}}</h1>
      <p class="ids-roll-actor" data-live-roll-actor hidden></p>
      <p class="ids-subtitle ids-roll-details" data-live-roll-details>{{localize "IDS.Latest.Listening"}}</p>
    </div>
  </div>
</section>
